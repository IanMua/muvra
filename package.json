{
  "name": "muvra",
  "version": "0.1.0-alpha.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "description": "Vue page-stack navigation with independent layers and managed transition lifecycles",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./extensions/backdrop": {
      "types": "./dist/extensions/backdrop.d.ts",
      "import": "./dist/extensions/backdrop.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "MIGRATION.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tests/types/tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "demo:build": "node scripts/build-demo.mjs",
    "demo": "node scripts/serve.mjs",
    "test:consumer": "node scripts/consumer-check.mjs",
    "test:mutations": "node scripts/mutations.mjs",
    "verify": "node scripts/verify.mjs",
    "format:check": "prettier --check src tests scripts demo/transitions demo/main.ts demo/index.html demo/props.ts demo/props.html demo/effects.ts demo/effects.html demo/layers.ts demo/layers.html package.json tsconfig.json playwright.config.ts README.md MIGRATION.md CONTRIBUTING.md",
    "typecheck:sfc": "node scripts/sfc-check.mjs",
    "prepack": "pnpm build",
    "check:package": "node scripts/check-package.mjs"
  },
  "peerDependencies": {
    "vue": "^3.5.25"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.1",
    "@vue/server-renderer": "3.5.25",
    "esbuild": "0.25.12",
    "prettier": "3.7.3",
    "rxjs": "7.8.2",
    "typescript": "5.9.3",
    "vue": "3.5.25",
    "vue-tsc": "3.3.14"
  },
  "dependencies": {
    "tabbable": "6.3.0"
  },
  "license": "MIT",
  "keywords": [
    "vue",
    "navigation",
    "page-stack",
    "layers"
  ]
}
